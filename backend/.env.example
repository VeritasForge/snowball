# Backend environment — copy to .env and fill in real values. NEVER commit .env.
# The JWT SECRET_KEY signs access/refresh tokens; the entire auth, per-user
# rate-limit, and IDOR model depends on it staying secret. Use a long random value.

SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./snowball.db
